    "Start arms the recorder: a take opens when sound arrives, with half a second of pre-roll, and closes after the silence below. Stop disarms.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start arms the recorder: a take opens when sound arrives, with half a second of pre-roll, and closes after the silence below. Stop disarms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar deja la grabadora a la espera: la toma empieza cuando llega sonido, con medio segundo previo, y se cierra tras el silencio indicado abajo. Detener la desactiva."
          }
        }
      }
    },
