        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error al %1$@: %2$@."
          }
        }
      }
    },
    "%@ has %lld frames (%@ s), expected %lld frames (%@ s)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene %2$lld tramas (%3$@ s); se esperaban %4$lld (%5$@ s)."
          }
        }
      }
    },
    "%@ is playing but AudioCap has only received digital silence so far. This is expected during a silent intro. If you hear audio, check that AudioCap is allowed in System Settings › Privacy & Security › Screen & System Audio Recording, then stop and start again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está sonando, pero de momento AudioCap solo ha recibido silencio digital. Es normal si la pista empieza en silencio. Si oyes audio, comprueba que AudioCap tiene permiso en Ajustes del Sistema › Privacidad y seguridad › Grabación de pantalla y audio del sistema; después detén la grabación y vuelve a empezar."
          }
        }
      }
    },
