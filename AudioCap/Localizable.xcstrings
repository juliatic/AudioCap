{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ error %@." : {
      "comment" : "First: an error domain such as com.apple.coreaudio.avfaudio; second: the decoded status.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error de %1$@: %2$@."
          }
        }
      }
    },
    "%@ failed with %@." : {
      "comment" : "A CoreAudio call failed. First: the operation (for example \"Creating the process tap\"), second: the decoded status.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error al %1$@: %2$@."
          }
        }
      }
    },
    "%@ has %lld frames (%@ s), expected %lld frames (%@ s)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene %2$lld tramas (%3$@ s); se esperaban %4$lld (%5$@ s)."
          }
        }
      }
    },
    "%@ is playing but AudioCap only receives silence. Check that AudioCap is allowed in System Settings › Privacy & Security › Screen & System Audio Recording, then stop and start again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está sonando, pero AudioCap solo recibe silencio. Comprueba que AudioCap tiene permiso en Ajustes del Sistema › Privacidad y seguridad › Grabación de pantalla y audio del sistema; después detén la grabación y vuelve a empezar."
          }
        }
      }
    },
    "%@ is playing but the capture is silent. Reconnecting to it…" : {
      "comment" : "Shown while recording when the source app is playing but the tap delivers only zeros. The argument is the app name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está sonando, pero la captura está en silencio. Reconectando…"
          }
        }
      }
    },
